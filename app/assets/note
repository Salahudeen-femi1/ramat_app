  return (
    <Svg width={170} height={192} viewBox="0 0 160 180">
      <Ellipse cx={80} cy={177} rx={62} ry={5} fill="#0F2A0C" opacity={0.28} />
      <Path d="M52 52C52 12 108 12 108 52" fill="none" stroke="#CDB07C" strokeWidth={6} strokeLinecap="round" />
      <Path d="M30 50H130L138 166Q138 175 129 175H31Q22 175 22 166Z" fill="#EBD8B4" />
      <Path d="M100 50H130L138 166Q138 175 129 175H100Z" fill="#DDC699" opacity={0.75} />
      <Path d="M30 50H130L131 64H29Z" fill="#DCC59B" />
      <Rect x={46} y={86} width={68} height={68} rx={20} fill="#FDFBF7" />
      <G fill="none" stroke={C.primary} strokeWidth={4.5} strokeLinecap="round" strokeLinejoin="round">
        <Path d="M64 108h32l-2.5 30H66.5z" />
        <Path d="M71 108a9 9 0 0118 0" />
      </G>
    </Svg>
  );
}

function GoogleG() {
  return (
    <Svg width={20} height={20} viewBox="0 0 24 24">
      <Path d="M21.6 12.2c0-.7-.1-1.3-.2-1.9H12v3.6h5.4a4.6 4.6 0 01-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.2z" fill="#4285F4" />
      <Path d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0012 22z" fill="#34A853" />
      <Path d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 000 9.2L6.4 14z" fill="#FBBC05" />
      <Path d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 003.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z" fill="#EA4335" />
    </Svg>
  );
}

export default function LoginScreen() {
