  const [focused, setFocused] = useState<'email' | 'password' | null>(null);

  const fieldStyle = (name: 'email' | 'password') => [
    styles.field,
    focused === name && styles.fieldFocused,
  ];

  return (
    <View style={styles.root}>
      {/* ── Hero ─────────────────────────────────────────── */}
      <View style={styles.hero}>
